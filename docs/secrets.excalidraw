      "seed": 2027941218,
      "version": 211,
      "versionNonce": 393201406,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1704212571681,
      "link": null,
      "locked": false,
      "text": "Service manages creating secrets dynamically,\nand administers them. Connector to external \nsecrets manager systems (customer's), happens\nvia the UI. i.e - Use my hashicorp vault",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 73,
      "containerId": null,
      "originalText": "Service manages creating secrets dynamically,\nand administers them. Connector to external \nsecrets manager systems (customer's), happens\nvia the UI. i.e - Use my hashicorp vault",
      "lineHeight": 1.2
    },
    {
      "id": "GdzVvBf9RDD7eDQy7ikd-",
      "type": "text",
      "x": -152,
      "y": 230,
      "width": 412.5,
      "height": 76.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1528948094,
      "version": 259,
      "versionNonce": 764588002,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1704212571681,
      "link": null,
      "locked": false,
      "text": "Lowest work-effort required. \nDevelopers will use the SDK to read/write\nsecrets. Additional API calls are required,\nbut simplest implementation. Cloud-specific.",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 73,
      "containerId": null,
      "originalText": "Lowest work-effort required. \nDevelopers will use the SDK to read/write\nsecrets. Additional API calls are required,\nbut simplest implementation. Cloud-specific.",
      "lineHeight": 1.2
    },

      "isDeleted": false,
      "boundElements": null,
      "updated": 1708002472159,
      "link": null,
      "locked": false,
      "text": "P0: Deploys mssb service to cluster\n\nP1: db-init: initializes pg db (sql scripts)\nP1: db-init: writes db_users_credentials secrets to vault\n  \nP2: init-container: fetches user_db_credentials for init process\nP2: init-container: writes secrets to vault\n\nP3: main: application starts\nP3: main: application fetches required secrets from mssb",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 188,
      "containerId": null,
      "originalText": "P0: Deploys mssb service to cluster\n\nP1: db-init: initializes pg db (sql scripts)\nP1: db-init: writes db_users_credentials secrets to vault\n  \nP2: init-container: fetches user_db_credentials for init process\nP2: init-container: writes secrets to vault\n\nP3: main: application starts\nP3: main: application fetches required secrets from mssb",
      "lineHeight": 1.2
    },

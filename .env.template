# ------------------------------------
# AWS Environment Variables (required)
# If you have a profile you want to use in your ~/.aws/credentials file, set it here.
# ------------------------------------
AWS_PROFILE=
AWS_REGION=
AWS_ACCOUNT_ID=

# ------------------------------------
# AWS Resources (required)
# ------------------------------------
# Please set this to the name of the ECR repository where images are shared with the respective AWS account.
AWS_ECR_REPO_URL=

# Please set this to the ARN of the ACM certificate to use for the ALB. 
AWS_CUSTOMER_CERTIFICATE_ARN=

# Please set this to the apex domain being used in the certificate provided above
AWS_CUSTOMER_APEX_DOMAIN=

# Please set this to the ID of the VPC where the ALB and ECS cluster will be deployed.
AWS_VPC_ID=

# Please set this as a comma-separated list of subnet IDs, e.g. subnet-12345678,subnet-87654321
AWS_PRIVATE_SUBNET_IDS=

# ------------------------------------
# AWS KMS Keys (Customer Provided)
# ------------------------------------
# KMS for EKS
AWS_KMS_EKS_KEY_ARN=

# KMS for EFS
AWS_KMS_EFS_KEY_ARN=

# KMS for RDS
AWS_KMS_RDS_KEY_ARN=

# KMS for application
AWS_MKS_INIT_KEY_ARN=

# KMS to encrypt secrets
AWS_KMS_SM_KEY_ARN=

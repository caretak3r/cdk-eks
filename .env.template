# AWS Environment Variables (required)
AWS_PROFILE=default
AWS_REGION=
AWS_ACCOUNT_ID=

# AWS Credentials (optional, if you're not using your ~/.aws/credentials file)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS Resources (required)
AWS_ECR_REPO_URL=
AWS_CERTIFICATE_ARN=
AWS_VPC_ID=
# Please set this as a comma-separated list of subnet IDs, e.g. AWS_PRIVATE_SUBNET_IDS=subnet-1,subnet-2
AWS_PRIVATE_SUBNET_IDS=
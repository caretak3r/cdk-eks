#!make
ifneq (,$(wildcard ./.env))
    include .env
    export
endif

bootstrap:
	cdk bootstrap --termination-protection=true --toolkit-stack-name tkp-cdk-toolkit --qualifier c1 --tags "managed_by=c1-tkp-cdk"

deploy:
	cdk deploy --require-approval=never --no-previous-parameters

.PHONY: bootstrap synth deploy
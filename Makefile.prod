#!make
ifneq (,$(wildcard ./.env))
    include .env
    export
endif

bootstrap:
	cdk bootstrap --termination-protection=true --toolkit-stack-name platform-cdk-toolkit --qualifier pg --tags "managed_by=platform-cdk" 2>&1 | tee logs/deploy.log

deploy:
	cdk deploy --require-approval=never --no-previous-parameters --all 2>&1 | tee logs/deploy.log

.PHONY: bootstrap deploy